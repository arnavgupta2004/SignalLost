  "voiceover": [
    {
      "scene": "S01",
      "start": 0.9,
      "end": 6.4,
      "text": "Six people are stranded in a failing capsule. The rescue ship's sensors are dark.",
      "cue": "Radar sweep finds six life signs; SignalLost wordmark resolves."
    },
    {
      "scene": "S02",
      "start": 7.4,
      "end": 15.4,
      "text": "SignalLost is a rescue game for a Twitch stream. The streamer flies the ship. The audience sees what the pilot cannot.",
      "cue": "Real landing page; then the pilot's limits and the crew's scans side by side, the one safe sector highlighted."
    },
    {
      "scene": "S03",
      "start": 16.5,
      "end": 28.3,
      "text": "One Node server runs the mission and sends each screen only what its role allows. Viewers receive the intel. The cockpit and the stream overlay never do.",
      "cue": "Mission engine diagram; state packets to all three screens, intel packets only to the crew."
    },
    {
      "scene": "S04",
      "start": 29.4,
      "end": 35.4,
      "text": "Every system splits the evidence. The pilot knows the hull's limits; chat holds the scans.",
      "cue": "Crew proposes the safe sector; pilot sets course and the corridor clears."
    },
    {
      "scene": "S04",
      "start": 35.9,
      "end": 42.0,
      "text": "Engineers reason through four wiring rules that allow exactly one answer.",
      "cue": "Crew reads the wiring rules and proposes relays; pilot flips them and engages power."
    },
    {
      "scene": "S04",
      "start": 42.6,
      "end": 48.6,
      "text": "Chat decodes the symbols, but the order to send them appears only in the cockpit.",
      "cue": "Crew maps bands to symbols; pilot enters them in transmission order and transmits."
    },
    {
      "scene": "S05",
      "start": 49.4,
      "end": 53.6,
      "text": "The final approach is flown by hand against ion drift.",
      "cue": "Crew sees the safe lane; pilot steers, engages the tractor beam."
    },
    {
      "scene": "S05",
      "start": 55.4,
      "end": 62.4,
      "text": "Any viewer can send boost to steady the ship for six seconds: one cell each, three per mission.",
      "cue": "Boost lands; stabilization countdown; recovery climbs (sped up 2.4\u00d7) to the debrief."
    },
    {
      "scene": "S06",
      "start": 64.6,
      "end": 74.6,
      "text": "Live chat reaches the server through Twitch EventSub, with a read-only scope. Messages are de-duplicated, parsed into commands, and survive reconnects.",
      "cue": "A !boost message travels OAuth \u2192 EventSub \u2192 de-duplication \u2192 parser \u2192 engine."
    },
    {
      "scene": "S07",
      "start": 75.5,
      "end": 85.8,
      "text": "Everything shown is the real app in training mode, with a simulated crew. Forty-two automated tests cover the rules; real chat is proven only on stream.",
      "cue": "Synthetic validation versus real-world validation, side by side."
    },
    {
      "scene": "S08",
      "start": 86.4,
      "end": 89.4,
      "text": "Six lives. One pilot. A whole crew.",
      "cue": "End card: wordmark, live URL and repository."
    }
  ],
